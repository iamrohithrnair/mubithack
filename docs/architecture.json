{
  "title": "Precedenz architecture",
  "subtitle": "An agent may read and propose. Deterministic code decides, Banyan Sapling verifies, and only a person teaches, activates or overrules a precedent. Every model call goes through Mubit.",
  "note": "All in this repository. Built in: returns, AP invoices. Planted from templates, as data: meal claims, access requests, meeting invites. Business systems are simulated.",
  "tiers": [
    {
      "id": "surfaces",
      "name": "Surfaces",
      "role": "How work arrives, and where a person acts on it",
      "nodes": [
        {
          "id": "api",
          "name": "Decision API",
          "meta": "POST /v1/decide · receipts",
          "functions": [
            "Any pipeline: follow or ask",
            "Idempotent; receipts never change"
          ]
        },
        {
          "id": "clients",
          "name": "CLI · MCP · Python",
          "meta": "precedenz · precedenz-mcp",
          "functions": [
            "An AI agent can ask, never answer",
            "Person-only commands need the token"
          ]
        },
        {
          "id": "event",
          "name": "Returns-dock check-in",
          "meta": "POST /events/{case_id}",
          "functions": [
            "An event from the dock, not a chat prompt",
            "Nine demo cases, one per boundary"
          ]
        },
        {
          "id": "web",
          "name": "Web app and live map",
          "meta": "Inbox · Policies · Dashboard · Map",
          "functions": [
            "Where a person reads and decides",
            "Every pulse on the map is a real decision"
          ]
        }
      ]
    },
    {
      "id": "reasoning",
      "name": "Model reasoning",
      "role": "May read and propose. May never act.",
      "nodes": [
        {
          "id": "agent",
          "name": "One Strands agent",
          "meta": "investigate · card · propose",
          "functions": [
            "Read-only tools; typed output",
            "Re-derived and reconciled downstream"
          ]
        },
        {
          "id": "reader",
          "name": "Workstream reader",
          "meta": "planted workstreams",
          "functions": [
            "Reads free text into typed fields",
            "Disagreeing with the caller asks"
          ]
        },
        {
          "id": "provider",
          "name": "Mubit gateway",
          "meta": "gpt-6-luna · Responses API",
          "functions": [
            "One stable task per workstream",
            "Session per case; request IDs on receipts"
          ]
        },
        {
          "id": "tools",
          "name": "Read-only tools",
          "meta": "five, all side-effect free",
          "functions": [
            "get_return_case · find_approved_policy",
            "compare_expected_and_received",
            "lookup_replacement_cost · replay (dry run)"
          ]
        }
      ]
    },
    {
      "id": "control",
      "name": "Control plane",
      "role": "Deterministic. The only thing that decides.",
      "nodes": [
        {
          "id": "decide",
          "name": "Decision service",
          "meta": "assess_case · follow or ask",
          "functions": [
            "One engine per workstream",
            "Any failure asks, never acts"
          ]
        },
        {
          "id": "facts",
          "name": "Facts",
          "meta": "derive · reconcile · snapshot",
          "functions": [
            "Re-derives every fact from source",
            "The model's report stays advisory"
          ]
        },
        {
          "id": "guardrails",
          "name": "Hard guardrails",
          "meta": "non-overridable",
          "functions": [
            "Run before any precedent",
            "Ceilings, always-ask rules, evidence"
          ]
        },
        {
          "id": "engine",
          "name": "Precedents",
          "meta": "data, never code",
          "functions": [
            "Matches active precedents",
            "No dynamic execution, ever"
          ]
        },
        {
          "id": "semantic",
          "name": "Banyan Sapling",
          "meta": "semantic check · Mubit",
          "functions": [
            "Reads raw evidence and notes",
            "Only supported may act"
          ]
        },
        {
          "id": "execute",
          "name": "Execute and verify",
          "meta": "inbox path · idempotency keys",
          "functions": [
            "Work order, disposition, close",
            "API callers execute themselves"
          ]
        },
        {
          "id": "domains",
          "name": "Domain packs",
          "meta": "returns · AP · planted",
          "functions": [
            "Built in, or a contract planted as data",
            "Facts, guardrails, actions, past answers"
          ]
        }
      ]
    },
    {
      "id": "governance",
      "name": "Governance",
      "role": "How one answer becomes a precedent",
      "nodes": [
        {
          "id": "card",
          "name": "Decision card",
          "meta": "ask once, with a recommendation",
          "functions": [
            "Evidence, with the tool that produced it",
            "Proposed boundaries and open questions"
          ]
        },
        {
          "id": "human",
          "name": "A person",
          "meta": "answer · remember · activate · overrule",
          "functions": [
            "Answering records a decision only",
            "Activating needs the approval token"
          ]
        },
        {
          "id": "candidate",
          "name": "Candidate precedent",
          "meta": "schema-validated, inert",
          "functions": [
            "Drafted from the answer, or proposed",
            "Conditions from an allowlist"
          ]
        },
        {
          "id": "replay",
          "name": "Replay gate",
          "meta": "past answers · labeled cases",
          "functions": [
            "One wrong action blocks activation",
            "Reads fact snapshots, not live rows"
          ]
        },
        {
          "id": "active",
          "name": "Active precedent",
          "meta": "versioned · diffed · overrulable",
          "functions": [
            "Covered waiting questions resolve",
            "Overrule stops it at once"
          ]
        }
      ]
    },
    {
      "id": "records",
      "name": "Systems of record",
      "role": "Synthetic business systems, real evidence",
      "nodes": [
        {
          "id": "returns",
          "name": "Returns system",
          "meta": "synthetic · read-only",
          "functions": [
            "Cases, bill of materials, evidence"
          ]
        },
        {
          "id": "parts",
          "name": "Parts catalog",
          "meta": "synthetic · read-only",
          "functions": [
            "Replacement cost and stock status"
          ]
        },
        {
          "id": "wms",
          "name": "Warehouse",
          "meta": "synthetic · writes",
          "functions": [
            "Work orders and dispositions",
            "Every write takes an idempotency key"
          ]
        },
        {
          "id": "apledger",
          "name": "AP ledger",
          "meta": "synthetic · second domain",
          "functions": [
            "Invoices, vendors, adjustments"
          ]
        },
        {
          "id": "audit",
          "name": "Audit log",
          "meta": "append-only · hash-chained",
          "functions": [
            "Every event, call, answer, action",
            "The database refuses UPDATE and DELETE"
          ]
        },
        {
          "id": "db",
          "name": "Database",
          "meta": "SQLite or PostgreSQL",
          "functions": [
            "One schema, versioned migrations",
            "Receipts, answers, fact snapshots"
          ]
        }
      ]
    }
  ],
