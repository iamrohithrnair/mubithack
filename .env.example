# OneDecision - example configuration.
# Copy to .env and fill in. NEVER commit a real .env file.

# --------------------------------------------------------------------------
# Model provider for the Strands agent.
#   scripted  - deterministic offline provider. No network, no credentials.
#               Used by unit tests, CI, and the fully offline demo.
#   bedrock   - Amazon Bedrock via the Strands BedrockModel provider.
#   anthropic - Anthropic API via the Strands AnthropicModel provider.
#   mubit     - Mubit gateway via the Strands OpenAIResponsesModel (Responses API).
# --------------------------------------------------------------------------
ONEDECISION_MODEL_PROVIDER=scripted

# --- bedrock provider -----------------------------------------------------
# Requires valid AWS credentials in the ambient chain and Bedrock model access.
# For Bedrock alone, a Bedrock API key can stand in for IAM credentials:
# AWS_BEARER_TOKEN_BEDROCK=
# Opus 5 is served only through a cross-Region inference profile: us. keeps
# traffic in US and Canada Regions, global. routes anywhere.
ONEDECISION_BEDROCK_MODEL_ID=us.anthropic.claude-opus-5
AWS_REGION=us-west-2

# --- anthropic provider ---------------------------------------------------
# ANTHROPIC_API_KEY=
# claude-opus-5 ($5/$25 per 1M) | claude-sonnet-5 ($2/$10) | claude-haiku-4-5 ($1/$5)
ONEDECISION_ANTHROPIC_MODEL_ID=claude-opus-5

# --- mubit provider -------------------------------------------------------
# Your Mubit key. Any other provider's key (e.g. Gemini) is added under
# Provider keys in the Mubit console; Mubit refuses it if sent per request.
# MUBIT_API_KEY=
# For Gemini instead: https://api.mubit.ai/gemini/v1beta/openai with
# gemini-3.8-flash (needs the Gemini key in the Mubit console).
# ONEDECISION_MUBIT_BASE_URL=https://api.mubit.ai/openai/v1
ONEDECISION_MUBIT_MODEL_ID=gpt-6-luna

# --------------------------------------------------------------------------
# Database.
#   Set ONEDECISION_DATABASE_URL to run on PostgreSQL - the deployment target.
#   Leave it unset to fall back to the zero-setup SQLite demo backend.
#   DATABASE_URL is also honored, since managed platforms inject that name.
#   NEVER commit a real DSN: it carries a password.
# --------------------------------------------------------------------------
# ONEDECISION_DATABASE_URL=postgresql://onedecision:CHANGE_ME@127.0.0.1:5432/onedecision
ONEDECISION_DB_POOL_MIN=1
ONEDECISION_DB_POOL_MAX=10
ONEDECISION_DB_CONNECT_TIMEOUT=10

# Enables the PostgreSQL half of the test suite. Point it at a THROWAWAY
# database: the suite drops and rebuilds the schema around every test.
# ONEDECISION_TEST_DATABASE_URL=postgresql://onedecision:CHANGE_ME@127.0.0.1:5432/onedecision_test

# --- application ----------------------------------------------------------
# SQLite demo backend only; ignored when a DATABASE_URL is set.
ONEDECISION_DB_PATH=var/onedecision.db
ONEDECISION_CONFIDENCE_THRESHOLD=0.75
ONEDECISION_MODEL_TIMEOUT_SECONDS=60

# Shared secret required by restricted endpoints (policy activation and
# execution). Generate your own; the value below is a non-secret placeholder.
ONEDECISION_APPROVAL_TOKEN=replace-me-local-demo-token

# --- observability (optional) ---------------------------------------------
# ONEDECISION_OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=
